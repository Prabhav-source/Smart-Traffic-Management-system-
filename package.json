{
  "name": "smart-traffic-dijkstra",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Smart Traffic Signal Management - Emergency Vehicle Shortest Path (Dijkstra's Algorithm) interactive prototype",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty",
    "lint": "tsc -b",
    "verify": "esbuild scripts/verify.ts --bundle --platform=node --format=esm --outfile=node_modules/.tmp/verify.mjs --alias:@=./src && node node_modules/.tmp/verify.mjs",
    "smoke": "esbuild scripts/smoke.tsx --bundle --platform=node --format=cjs --jsx=automatic --outfile=node_modules/.tmp/smoke.cjs --alias:@=./src && node node_modules/.tmp/smoke.cjs",
    "check": "npm run typecheck && npm run verify && npm run smoke && npm run build"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.21.5",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
